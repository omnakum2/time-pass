# ─── Firebase Web (client) ───────────────────────────────────────────────────
# From the SAME Firebase project as the server:
#   Firebase console → Project settings → Your apps → Web app → SDK setup and config.
# Vite only exposes vars prefixed with VITE_ to the browser. NEVER put admin/secret keys here.

VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-web-app-id
