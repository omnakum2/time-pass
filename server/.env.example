# ─── Firebase Admin (server) ─────────────────────────────────────────────────
# From your Firebase service-account JSON:
#   Firebase console → Project settings → Service accounts → Generate new private key.
# Set these on the host (e.g. Render → Environment). NEVER commit real values.

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# Copy `private_key` from the JSON verbatim — keep the literal \n escapes, wrap in double quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExxxx...\n-----END PRIVATE KEY-----\n"
